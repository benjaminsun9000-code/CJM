\section*{Introduction}
When I studied Gilbert Strang's \emph{``Linear Algebra and Its Applications''}, his explanation of Schur Form was not very clear. This led me to find out more about Schur decomposition to the point where I could implement it.

\section{Theorem Statement}
\begin{theorem}[Schur Decomposition]
Let $A \in \mathbb{C}^{n \times n}$. There exists a unitary matrix $U \in \mathbb{C}^{n \times n}$ and an upper triangular matrix $T \in \mathbb{C}^{n \times n}$ such that:
\[
U^{-1} A U = T \quad \iff \quad A = U T U^{\dagger}
\]
\end{theorem}

\section{Proof and Method by Induction}

\subsection{Base Case}
For $A \in \mathbb{C}^{1 \times 1}$, $A = [a_{11}]$.
\begin{itemize}
    \item Choose $U_1 = [1]$, its inverse is $U_1^{-1} = [1]$.
    \item Compute $U_1^{-1} A U_1 = [1][a_{11}][1] = [a_{11}] = T$.
    \item A $1 \times 1$ matrix is trivially upper triangular.
\end{itemize}

\subsection{Inductive Hypothesis}
If any $(n-1) \times (n-1)$ matrix $A_2$ can be decomposed using a unitary matrix $W_2$ such that:
\[
W_2^{-1} A_2 W_2 = T_{n-1}
\]
where $T_{n-1}$ is an upper triangular matrix.

\subsection{Inductive Step}
Let $A$ be an arbitrary $n \times n$ matrix. We must reduce it to size $(n-1) \times (n-1)$ and link it to our hypothesis.

\begin{enumerate}
    \item We use the Power Method (or general eigenvalue analysis) to find a dominant eigenvalue $\lambda_1$ and its corresponding non-zero eigenvector $\vec{u}_1$ such that $A \vec{u}_1 = \lambda_1 \vec{u}_1$.
    \item We use the Gram-Schmidt process to expand our eigenvector $\vec{u}_1$ to a set of orthonormal vectors $\{\vec{u}_1, \vec{u}_2, \dots, \vec{u}_n\}$.
    \item Construct $U_1$: We place these vectors as the columns of $U_1$:
    \[
    U_1 = \begin{bmatrix} \vec{u}_1 & \vec{u}_2 & \dots & \vec{u}_n \end{bmatrix}
    \]
\end{enumerate}

We want to prove that $U_1^{-1} A U_1$ has zeros everywhere in the first column below $\lambda_1$:
\[
U_1^{-1} A U_1 = \begin{bmatrix} \lambda_1 & c_1^T \\ \mathbf{0} & A_2 \end{bmatrix}
\]

Starting with the matrix product $A U_1$:
\[
A U_1 = \begin{bmatrix} A \vec{u}_1 & A \vec{u}_2 & \dots & A \vec{u}_n \end{bmatrix}
\]
Let $T_1$ be the matrix representation:
\[
A U_1 = \begin{bmatrix} \vec{u}_1 & \vec{u}_2 & \dots & \vec{u}_n \end{bmatrix} \begin{bmatrix} 
t_{11} & t_{12} & \dots & t_{1n} \\ 
t_{21} & t_{22} & \dots & t_{2n} \\ 
\vdots & \vdots & \ddots & \vdots \\ 
t_{n1} & t_{n2} & \dots & t_{nn} 
\end{bmatrix}
\]

The first columns are the same:
\[
A \vec{u}_1 = t_{11} \vec{u}_1 + t_{21} \vec{u}_2 + \dots + t_{n1} \vec{u}_n
\]
Since $A \vec{u}_1 = \lambda_1 \vec{u}_1$:
\[
\lambda_1 \vec{u}_1 = t_{11} \vec{u}_1 + t_{21} \vec{u}_2 + \dots + t_{n1} \vec{u}_n
\]
\[
(t_{11} - \lambda_1) \vec{u}_1 + t_{21} \vec{u}_2 + \dots + t_{n1} \vec{u}_n = \vec{0}
\]
Since $\vec{u}_1, \vec{u}_2, \dots, \vec{u}_n$ are linearly independent:
\[
t_{11} - \lambda_1 = 0 \implies t_{11} = \lambda_1
\]
and
\[
t_{21} = 0, \quad t_{31} = 0, \quad \dots, \quad t_{n1} = 0
\]
This means that except for $t_{11} = \lambda_1$, the entries in the first column are zero:
\[
t_{21} = t_{31} = \dots = t_{n1} = 0
\]
So $A U_1 = U_1 \begin{bmatrix} \lambda_1 & c_1^T \\ \mathbf{0} & A_2 \end{bmatrix}$.

Multiplying by $U_1^{-1}$:
\[
U_1^{-1} A U_1 = \begin{bmatrix} \lambda_1 & c_1^T \\ \mathbf{0} & A_2 \end{bmatrix}
\]

The inner submatrix $A_2$ has dimension $(n-1) \times (n-1)$. By our inductive hypothesis, we can recursively decompose $A_2$. There exists an $(n-1) \times (n-1)$ unitary matrix $W_2$ such that $W_2^{-1} A_2 W_2 = T_{n-1}$ is upper triangular.

Define:
\[
U_2 = \begin{bmatrix} 1 & \mathbf{0}^T \\ \mathbf{0} & W_2 \end{bmatrix}, \quad U_2^{-1} = \begin{bmatrix} 1 & \mathbf{0}^T \\ \mathbf{0} & W_2^{-1} \end{bmatrix}
\]

We substitute into $U_2^{-1} (U_1^{-1} A U_1) U_2$:
\begin{align*}
U_2^{-1} (U_1^{-1} A U_1) U_2 &= \begin{bmatrix} 1 & \mathbf{0}^T \\ \mathbf{0} & W_2^{-1} \end{bmatrix} \begin{bmatrix} \lambda_1 & c_1^T \\ \mathbf{0} & A_2 \end{bmatrix} \begin{bmatrix} 1 & \mathbf{0}^T \\ \mathbf{0} & W_2 \end{bmatrix} \\
&= \begin{bmatrix} \lambda_1 & c_1^T W_2 \\ \mathbf{0} & W_2^{-1} A_2 W_2 \end{bmatrix}
\end{align*}

Since $W_2^{-1} A_2 W_2 = T_{n-1}$:
\[
U_2^{-1} (U_1^{-1} A U_1) U_2 = \begin{bmatrix} \lambda_1 & c_1^T W_2 \\ \mathbf{0} & T_{n-1} \end{bmatrix} = \text{upper triangular matrix}
\]

The final upper triangular matrix $T$ is:
\[
T = \begin{bmatrix} \lambda_1 & c_1^T W_2 \\ \mathbf{0} & T_{n-1} \end{bmatrix}
\]
Since $T_{n-1}$ is upper triangular, this keeps the full matrix $T$ upper triangular.

The full unitary transformation matrix is:
\[
U = U_1 U_2 U_3 \dots U_n
\]
This is our final unitary matrix $U$.

Since we have proved that an $n \times n$ matrix can be decomposed if an $(n-1) \times (n-1)$ matrix can, and our base case works, we have proven Schur Decomposition by induction and derived a method to compute it.

\section{Properties of the Unitary Product and Eigenvalues}

To prove that the product of unitary matrices is unitary, note that for $U_1, U_2$:
\[
(U_1 U_2)^H = U_2^H U_1^H = U_2^{-1} U_1^{-1} = (U_1 U_2)^{-1}
\]
because $U_2^{-1} U_1^{-1} U_1 U_2 = I$.

\subsection{Eigenvalues on the Diagonal}
The eigenvalues of $A$ are on $T$'s diagonal. This is because $A$'s eigenvalues and $T$'s eigenvalues are the same, and $T$'s eigenvalues lie on its diagonal.

Evaluating $\det(T - \lambda I)$:
\[
\det(T - \lambda I) = \det \begin{bmatrix} \lambda_1 - \lambda & & * \\ & \lambda_2 - \lambda & \\ 0 & & \ddots \end{bmatrix} = (\lambda_1 - \lambda)(\lambda_2 - \lambda)\dots(\lambda_n - \lambda)
\]
Since the terms below $(\lambda_1 - \lambda)$ are 0, the determinant simplifies directly to the product of diagonal entries.

To prove that $A$'s eigenvalues are $T$'s eigenvalues:
\begin{align*}
\det(A - \lambda I) &= \det(U T U^{-1} - \lambda U U^{-1}) \\
&= \det(U) \det(T - \lambda I) \det(U^{-1}) \\
&= \det(U U^{-1}) \det(T - \lambda I) \\
&= \det(T - \lambda I)
\end{align*}

Because $A$'s eigenvalues are equivalent to $T$'s eigenvalues, and $T$'s eigenvalues lie on its diagonal, $A$'s eigenvalues can be read directly off $T$'s diagonal.

